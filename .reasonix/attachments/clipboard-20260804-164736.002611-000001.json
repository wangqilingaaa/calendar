{
  "openapi": "3.0.3",
  "info": {
    "title": "travel_route Meal Plan API",
    "version": "1.0.0",
    "description": "travel_route 周计划模块接口定义（支持 Apifox/FixAPI 直接导入）"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Response": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": -1
          },
          "message": {
            "type": "string",
            "example": "invalid request"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "MealID": {
        "type": "string",
        "description": "固定餐次标识",
        "enum": [
          "breakfast",
          "lunch",
          "dinner",
          "snack"
        ],
        "example": "breakfast"
      },
      "WeeklyMealPlanItem": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "example": 1
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "DeletedAt": {
            "type": "string",
            "nullable": true
          },
          "weekly_meal_plan_id": {
            "type": "integer",
            "example": 1
          },
          "day_index": {
            "type": "integer",
            "description": "周内天序号，0=周一，6=周日",
            "example": 0
          },
          "meal_id": {
            "$ref": "#/components/schemas/MealID"
          },
          "sort_order": {
            "type": "integer",
            "example": 0
          },
          "dish_name": {
            "type": "string",
            "example": "番茄炒蛋"
          },
          "done": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "MealPlanDish": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "番茄炒蛋"
          },
          "done": {
            "type": "boolean",
            "example": false
          },
          "day_index": {
            "type": "integer",
            "example": 0
          },
          "meal_id": {
            "$ref": "#/components/schemas/MealID"
          },
          "sort_order": {
            "type": "integer",
            "example": 0
          }
        }
      },
      "MealPlanDay": {
        "type": "object",
        "properties": {
          "breakfast": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MealPlanDish"
            }
          },
          "lunch": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MealPlanDish"
            }
          },
          "dinner": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MealPlanDish"
            }
          },
          "snack": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MealPlanDish"
            }
          }
        }
      },
      "MealPlanDetail": {
        "type": "object",
        "properties": {
          "exists": {
            "type": "boolean",
            "description": "该周计划是否已存在",
            "example": true
          },
          "id": {
            "type": "integer",
            "description": "周计划主键；当 exists=false 时为 0",
            "example": 1
          },
          "user_id": {
            "type": "integer",
            "example": 1
          },
          "week_start_date": {
            "type": "string",
            "format": "date",
            "description": "周一日期，必须是周一",
            "example": "2026-07-20"
          },
          "plan": {
            "type": "array",
            "description": "长度固定为 7，下标 0=周一，6=周日",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "$ref": "#/components/schemas/MealPlanDay"
            }
          }
        }
      },
      "CreateMealPlanRequest": {
        "type": "object",
        "properties": {
          "week_start_date": {
            "type": "string",
            "format": "date",
            "description": "需要创建的目标周一日期",
            "example": "2026-07-20"
          }
        },
        "required": [
          "week_start_date"
        ]
      },
      "AddMealPlanItemRequest": {
        "type": "object",
        "properties": {
          "day_index": {
            "type": "integer",
            "description": "周内天序号，0=周一，6=周日",
            "example": 0
          },
          "meal_id": {
            "$ref": "#/components/schemas/MealID"
          },
          "name": {
            "type": "string",
            "description": "菜名",
            "example": "番茄炒蛋"
          },
          "done": {
            "type": "boolean",
            "description": "是否已打卡",
            "example": false
          },
          "sort_order": {
            "type": "integer",
            "description": "可选排序值；不传时自动追加到当前餐次末尾",
            "example": 0
          }
        },
        "required": [
          "day_index",
          "meal_id",
          "name"
        ]
      },
      "UpdateMealPlanItemRequest": {
        "type": "object",
        "description": "支持局部更新，任意字段可单独提交",
        "properties": {
          "day_index": {
            "type": "integer",
            "description": "周内天序号，0=周一，6=周日",
            "example": 0
          },
          "meal_id": {
            "$ref": "#/components/schemas/MealID"
          },
          "name": {
            "type": "string",
            "example": "牛奶燕麦"
          },
          "done": {
            "type": "boolean",
            "example": true
          },
          "sort_order": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "CopyLastWeekRequest": {
        "type": "object",
        "properties": {
          "week_start_date": {
            "type": "string",
            "format": "date",
            "description": "目标周的周一日期；系统会自动复制上一周同一天对应的计划",
            "example": "2026-07-27"
          }
        },
        "required": [
          "week_start_date"
        ]
      }
    }
  },
  "paths": {
    "/meal-plan": {
      "get": {
        "summary": "查询指定周的周计划",
        "description": "根据周一日期查询当前登录用户的周计划。若该周尚未创建，返回 exists=false 和一个空的 7 天结构。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "week_start_date",
            "in": "query",
            "required": true,
            "description": "目标周的周一日期，格式为 yyyy-mm-dd，且必须是周一",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-07-20"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/MealPlanDetail"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "创建某一周的空白周计划",
        "description": "只创建周计划主表，不自动插入空白食谱项。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMealPlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/MealPlanDetail"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meal-plan/copy-last-week": {
      "post": {
        "summary": "复制上周计划到目标周",
        "description": "复制上一周的菜品明细到目标周。复制后会保留菜名、天序号、餐次和排序，但打卡状态 done 会被重置为 false。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopyLastWeekRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/MealPlanDetail"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meal-plan/{id}/items": {
      "post": {
        "summary": "向指定周计划中添加食谱",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "周计划主键 ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMealPlanItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WeeklyMealPlanItem"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meal-plan/items/{item_id}": {
      "put": {
        "summary": "修改单条食谱",
        "description": "支持局部更新，可只修改菜名、打卡状态、餐次、日期或排序。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "description": "食谱项主键 ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMealPlanItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WeeklyMealPlanItem"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "删除单条食谱",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "description": "食谱项主键 ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 1
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
