{
  "openapi": "3.0.3",
  "info": {
    "title": "travel_route User Binding & Diary API",
    "version": "1.0.0",
    "description": "travel_route 用户认证、用户绑定与日记模块接口定义（支持 Apifox/FixAPI 直接导入）"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Response": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": -1
          },
          "message": {
            "type": "string",
            "example": "invalid request"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Diary": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "example": 1
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "DeletedAt": {
            "type": "string",
            "nullable": true
          },
          "user_id": {
            "type": "integer",
            "example": 1
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-07-13"
          },
          "person": {
            "type": "string",
            "example": "张三"
          },
          "event": {
            "type": "string",
            "example": "接口联调验证"
          },
          "event_remark": {
            "type": "string",
            "example": "需要自动同步"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "https://example.com/file-a.jpg"
            ]
          },
          "source_diary_id": {
            "type": "integer",
            "nullable": true,
            "example": 1
          },
          "source_user_id": {
            "type": "integer",
            "nullable": true,
            "example": 2
          }
        }
      },
      "UserBinding": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "example": 1
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "DeletedAt": {
            "type": "string",
            "nullable": true
          },
          "user_low_id": {
            "type": "integer",
            "example": 1
          },
          "user_high_id": {
            "type": "integer",
            "example": 2
          },
          "requested_by": {
            "type": "integer",
            "example": 1
          },
          "responded_by": {
            "type": "integer",
            "nullable": true,
            "example": 2
          },
          "bound_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "unbound_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "example": "active",
            "enum": [
              "pending",
              "active",
              "unbound",
              "rejected"
            ]
          }
        }
      },
      "DiaryDayGroup": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-07-13"
          },
          "count": {
            "type": "integer",
            "example": 2
          },
          "diaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diary"
            }
          }
        }
      },
      "DiaryQueryResult": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string",
            "example": "day"
          },
          "date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "month": {
            "type": "string",
            "example": "2026-07",
            "nullable": true
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "page_size": {
            "type": "integer",
            "example": 10
          },
          "total": {
            "type": "integer",
            "example": 1
          },
          "total_diaries": {
            "type": "integer",
            "nullable": true,
            "example": 3
          },
          "diaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diary"
            }
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiaryDayGroup"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/user/register": {
      "post": {
        "summary": "用户注册",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "username": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "summary": "用户登录",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "token": {
                              "type": "string"
                            },
                            "id": {
                              "type": "integer"
                            },
                            "username": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/binding/apply": {
      "post": {
        "summary": "发起用户绑定申请",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "target_user_id": {
                    "type": "integer",
                    "example": 2
                  }
                },
                "required": [
                  "target_user_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UserBinding"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/binding/{id}/accept": {
      "post": {
        "summary": "同意用户绑定申请",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UserBinding"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/binding/{id}/unbind": {
      "post": {
        "summary": "解绑用户关系",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UserBinding"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/diary": {
      "post": {
        "summary": "创建日记",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-07-13"
                  },
                  "person": {
                    "type": "string",
                    "example": "张三"
                  },
                  "event": {
                    "type": "string",
                    "example": "接口联调验证"
                  },
                  "event_remark": {
                    "type": "string",
                    "example": "需要自动同步"
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "https://example.com/file-a.jpg"
                    ]
                  }
                },
                "required": [
                  "date",
                  "event"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Diary"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "按天或按月查询日记",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "dimension",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "month"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "当 dimension=day 时必填，格式为 yyyy-mm-dd",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "当 dimension=month 时必填，格式为 yyyy-mm",
            "schema": {
              "type": "string",
              "example": "2026-07"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "person",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/DiaryQueryResult"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "批量删除日记",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [
                      1,
                      2
                    ]
                  }
                },
                "required": [
                  "ids"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "ids": {
                              "type": "array",
                              "items": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/diary/{id}": {
      "delete": {
        "summary": "删除单条日记",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Response"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
